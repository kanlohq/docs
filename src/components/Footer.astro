
---
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default {...Astro.props}><slot /></Default>

<footer class="site-footer">
  <p>© 2026 RealGolf.Games UG (haftungsbeschränkt)</p>

  <nav>
    <a href="https://kanlo.cc">{Astro.locals.t("link.website")}</a>
    <a href="/impressum">{Astro.locals.t("link.imprint")}</a>
    <a href="/datenschutz">{Astro.locals.t("link.privacy")}</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .site-footer a {
    color: inherit;
  }

  .site-footer .licenses {
    flex-basis: 100%;
    margin: 0;
  }
</style>
